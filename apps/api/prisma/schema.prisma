// ==============================================================================
// AIC-ADT Baramati Foundation — Prisma Schema
// Phase 3 Foundation: PostgreSQL 16+ Relational Core
// Scope: Foundational Identity (User/Role), Audit Log, and System Settings.
// Note: Domain models (Startups, Programs, Applications, Events, Impact) are
// intentionally deferred to their respective feature implementation phases.
// ==============================================================================

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

enum Role {
  PUBLIC_APPLICANT
  REVIEWER
  PROGRAM_MANAGER
  CONTENT_EDITOR
  APPROVER
  IMPACT_MANAGER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

// ------------------------------------------------------------------------------
// MODELS
// ------------------------------------------------------------------------------

/// System User and Identity Entity for Role-Based Access Control (RBAC)
model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(255)
  phone        String?    @db.VarChar(20)
  fullName     String     @map("full_name") @db.VarChar(150)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  role         Role       @default(PUBLIC_APPLICANT)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  auditLogs      AuditLog[]
  sessions       Session[]
  authoredNews      NewsArticle[]     @relation("AuthoredNews")
  authoredEvents    Event[]           @relation("AuthoredEvents")
  uploadedMedia     MediaAsset[]      @relation("UploadedMedia")
  authoredRevisions ContentRevision[] @relation("RevisionAuthor")
  reviewedRevisions ContentRevision[] @relation("RevisionReviewer")

  @@index([role], name: "idx_users_role")
  @@index([status], name: "idx_users_status")
  @@map("users")
}

/// Server-Side Authenticated Session for High-Entropy HttpOnly Cookies
model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relationships
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_sessions_user_id")
  @@index([expiresAt], name: "idx_sessions_expires_at")
  @@map("sessions")
}

/// Append-Only Audit Log for Administrative Actions and Security Governance
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(100)
  resource   String   @db.VarChar(100)
  resourceId String?  @map("resource_id") @db.VarChar(255)
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.Text
  metadata   Json?    @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relationships
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId], name: "idx_audit_logs_user_id")
  @@index([action], name: "idx_audit_logs_action")
  @@index([resource, resourceId], name: "idx_audit_logs_resource")
  @@index([createdAt(sort: Desc)], name: "idx_audit_logs_created_at")
  @@map("audit_logs")
}

/// Platform Configuration and Institutional Key-Value Store
model SystemSetting {
  key         String   @id @db.VarChar(100)
  value       Json     @db.JsonB
  description String?  @db.VarChar(255)
  isPublic    Boolean  @default(false) @map("is_public")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("system_settings")
}

// ------------------------------------------------------------------------------
// CONTENT MANAGEMENT & EDITORIAL WORKFLOW MODELS
// ------------------------------------------------------------------------------

enum ContentStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum ContentEntityType {
  NEWS
  EVENT
  STARTUP
  PROGRAM
  INSTITUTIONAL_PAGE
}

enum NewsCategory {
  OFFICIAL_ANNOUNCEMENT
  FUNDING_MILESTONE
  INFRASTRUCTURE
  ECOSYSTEM_PARTNERSHIP
}

/// Official Press Releases, Announcements, and Ecosystem Coverage
model NewsArticle {
  id                String            @id @default(uuid()) @db.Uuid
  slug              String            @unique @db.VarChar(100)
  category          NewsCategory      @default(OFFICIAL_ANNOUNCEMENT)
  publishDate       DateTime          @default(now()) @map("publish_date") @db.Timestamptz(6)
  sourceAttribution String            @map("source_attribution") @db.VarChar(200)
  externalPressLink String?           @map("external_press_link") @db.VarChar(255)
  thumbnailAssetId  String?           @map("thumbnail_asset_id") @db.Uuid
  currentVersion    Int               @default(1) @map("current_version")
  authorId          String?           @map("author_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  author            User?             @relation("AuthoredNews", fields: [authorId], references: [id], onDelete: SetNull)
  translations      NewsTranslation[]

  @@index([category], name: "idx_news_articles_category")
  @@index([publishDate], name: "idx_news_articles_publish_date")
  @@index([authorId], name: "idx_news_articles_author_id")
  @@map("news_articles")
}

/// Localized Content and Editorial Lifecycle for News Articles
model NewsTranslation {
  id          String        @id @default(uuid()) @db.Uuid
  articleId   String        @map("article_id") @db.Uuid
  locale      String        @db.VarChar(5)
  headline    String        @db.VarChar(255)
  summary     String        @db.VarChar(500)
  content     Json          @db.JsonB
  tags        Json          @default("[]") @db.JsonB
  keyFacts    Json?         @map("key_facts") @db.JsonB
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at") @db.Timestamptz(6)
  archivedAt  DateTime?     @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  article     NewsArticle   @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, locale], name: "uq_news_translations_locale")
  @@index([locale, status], name: "idx_news_translations_locale_status")
  @@map("news_translations")
}

enum EventCategory {
  INTAKE_DEADLINE
  TECHNICAL_WORKSHOP
  FIELD_SHOWCASE
  ECOSYSTEM_CONCLAVE
  TRAINING_BOOTCAMP
}

enum EventStatus {
  UPCOMING
  REGISTRATION_CLOSED
  CONCLUDED
  CANCELLED
  POSTPONED
}

enum VenueType {
  IN_PERSON
  ONLINE
  HYBRID
}

/// Official Incubator Events, Workshops, and Application Deadlines
model Event {
  id                   String             @id @default(uuid()) @db.Uuid
  slug                 String             @unique @db.VarChar(100)
  category             EventCategory      @default(TECHNICAL_WORKSHOP)
  eventStatus          EventStatus        @default(UPCOMING) @map("event_status")
  startDate            DateTime           @map("start_date") @db.Timestamptz(6)
  endDate              DateTime           @map("end_date") @db.Timestamptz(6)
  timeRange            String             @map("time_range") @db.VarChar(100)
  venueType            VenueType          @default(IN_PERSON) @map("venue_type")
  organizer            String             @db.VarChar(150)
  registrationUrl      String?            @map("registration_url") @db.VarChar(255)
  registrationDeadline DateTime?          @map("registration_deadline") @db.Timestamptz(6)
  isExternal           Boolean            @default(false) @map("is_external")
  bannerAssetId        String?            @map("banner_asset_id") @db.Uuid
  currentVersion       Int                @default(1) @map("current_version")
  authorId             String?            @map("author_id") @db.Uuid
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  author               User?              @relation("AuthoredEvents", fields: [authorId], references: [id], onDelete: SetNull)
  translations         EventTranslation[]

  @@index([category], name: "idx_events_category")
  @@index([eventStatus], name: "idx_events_status")
  @@index([startDate], name: "idx_events_start_date")
  @@index([authorId], name: "idx_events_author_id")
  @@map("events")
}

/// Localized Content and Editorial Lifecycle for Events
model EventTranslation {
  id               String        @id @default(uuid()) @db.Uuid
  eventId          String        @map("event_id") @db.Uuid
  locale           String        @db.VarChar(5)
  title            String        @db.VarChar(255)
  shortDescription String        @map("short_description") @db.VarChar(500)
  fullDescription  Json          @map("full_description") @db.JsonB
  venueName        String        @map("venue_name") @db.VarChar(200)
  venueAddress     String        @map("venue_address") @db.VarChar(300)
  targetAudience   Json          @default("[]") @map("target_audience") @db.JsonB
  agendaHighlights Json?         @default("[]") @map("agenda_highlights") @db.JsonB
  status           ContentStatus @default(DRAFT)
  reviewerNotes    String?       @map("reviewer_notes") @db.Text
  publishedAt      DateTime?     @map("published_at") @db.Timestamptz(6)
  archivedAt       DateTime?     @map("archived_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  event            Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, locale], name: "uq_event_translations_locale")
  @@index([locale, status], name: "idx_event_translations_locale_status")
  @@map("event_translations")
}

// ------------------------------------------------------------------------------
// MEDIA MANAGEMENT & STORAGE ASSET MODELS
// ------------------------------------------------------------------------------

enum MediaVisibility {
  PUBLIC
  PRIVATE
  ARCHIVED
}

enum MediaType {
  IMAGE
  DOCUMENT
  VIDEO
  OTHER
}

enum DocumentType {
  ANNUAL_REPORT
  FINANCIAL_AUDIT
  POLICY_REGULATION
  PITCH_DECK
  EVENT_BROCHURE
  OTHER
}

/// Managed Media Assets, Photographic Records, and Official PDFs
model MediaAsset {
  id              String          @id @default(uuid()) @db.Uuid
  originalName    String          @map("original_name") @db.VarChar(255)
  storageKey      String          @unique @map("storage_key") @db.VarChar(500)
  storagePath     String          @map("storage_path") @db.VarChar(500)
  publicUrl       String?         @map("public_url") @db.VarChar(500)
  mimeType        String          @map("mime_type") @db.VarChar(100)
  fileSizeBytes   Int             @map("file_size_bytes")
  fileExtension   String          @map("file_extension") @db.VarChar(20)
  checksumSha256  String          @map("checksum_sha256") @db.VarChar(64)
  mediaType       MediaType       @default(IMAGE) @map("media_type")
  visibility      MediaVisibility @default(PUBLIC)

  // Image-specific metadata
  width           Int?
  height          Int?
  altTextEn       String?         @map("alt_text_en") @db.VarChar(255)
  altTextMr       String?         @map("alt_text_mr") @db.VarChar(255)
  caption         String?         @db.VarChar(500)
  attribution     String?         @db.VarChar(255)

  // Document-specific metadata
  documentType    DocumentType?   @map("document_type")
  reportingPeriod String?         @map("reporting_period") @db.VarChar(50)
  isStatutory     Boolean         @default(false) @map("is_statutory")

  // Association and Governance
  usageCount      Int             @default(0) @map("usage_count")
  uploaderId      String?         @map("uploader_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  uploader        User?           @relation("UploadedMedia", fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([mediaType], name: "idx_media_assets_type")
  @@index([visibility], name: "idx_media_assets_visibility")
  @@index([documentType], name: "idx_media_assets_doc_type")
  @@index([uploaderId], name: "idx_media_assets_uploader_id")
  @@index([createdAt(sort: Desc)], name: "idx_media_assets_created_at")
  @@map("media_assets")
}

/// Immutable Historical Revisions and Draft Staging for Published Content
model ContentRevision {
  id            String            @id @default(uuid()) @db.Uuid
  entityType    ContentEntityType @map("entity_type")
  entityId      String            @map("entity_id") @db.Uuid
  versionNumber Int               @map("version_number")
  locale        String            @db.VarChar(5)
  status        ContentStatus     @default(DRAFT)
  dataSnapshot  Json              @map("data_snapshot") @db.JsonB
  authorId      String?           @map("author_id") @db.Uuid
  reviewerId    String?           @map("reviewer_id") @db.Uuid
  reviewNotes   String?           @map("review_notes") @db.Text
  changelog     String?           @db.VarChar(500)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relationships
  author        User?             @relation("RevisionAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reviewer      User?             @relation("RevisionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@unique([entityType, entityId, versionNumber, locale], name: "uq_revisions_entity_version_locale")
  @@index([entityType, entityId], name: "idx_revisions_entity")
  @@index([status], name: "idx_revisions_status")
  @@index([authorId], name: "idx_revisions_author")
  @@index([reviewerId], name: "idx_revisions_reviewer")
  @@index([createdAt(sort: Desc)], name: "idx_revisions_created_at")
  @@map("content_revisions")
}

