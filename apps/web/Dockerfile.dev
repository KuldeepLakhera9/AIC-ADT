# ==============================================================================
# AIC-ADT Baramati Foundation — Next.js Web Development Dockerfile
# Canonical definition located at: infra/docker/Dockerfile.web
# ==============================================================================

FROM node:22-alpine AS dev

# Install libc compatibility and networking utilities
RUN apk add --no-cache libc6-compat curl wget

# Enable pnpm matching the repository lockfile (v11.16.0)
RUN corepack enable && corepack prepare pnpm@11.16.0 --activate

WORKDIR /app

# Copy root workspace manifests and lockfile for reproducible dependency resolution
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/web/package.json ./apps/web/
COPY apps/api/package.json ./apps/api/

# Install workspace dependencies deterministically
RUN pnpm install --frozen-lockfile

# Copy frontend source code and configuration
COPY apps/web ./apps/web

WORKDIR /app/apps/web

# Ensure node non-root user owns the application directory
RUN chown -R node:node /app

# Switch to non-root execution (security requirement DEP-CNT-03)
USER node

EXPOSE 3000

ENV NODE_ENV=development
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["pnpm", "dev"]
