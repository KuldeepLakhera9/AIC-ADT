// ==============================================================================
// AIC-ADT Baramati Foundation — Prisma Schema
// Phase 3 Foundation: PostgreSQL 16+ Relational Core
// Scope: Foundational Identity (User/Role), Audit Log, and System Settings.
// Note: Domain models (Startups, Programs, Applications, Events, Impact) are
// intentionally deferred to their respective feature implementation phases.
// ==============================================================================

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

enum Role {
  PUBLIC_APPLICANT
  REVIEWER
  PROGRAM_MANAGER
  CONTENT_EDITOR
  APPROVER
  IMPACT_MANAGER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

// ------------------------------------------------------------------------------
// MODELS
// ------------------------------------------------------------------------------

/// System User and Identity Entity for Role-Based Access Control (RBAC)
model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(255)
  phone        String?    @db.VarChar(20)
  fullName     String     @map("full_name") @db.VarChar(150)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  role         Role       @default(PUBLIC_APPLICANT)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  auditLogs    AuditLog[]
  sessions     Session[]
  authoredNews NewsArticle[] @relation("AuthoredNews")

  @@index([role], name: "idx_users_role")
  @@index([status], name: "idx_users_status")
  @@map("users")
}

/// Server-Side Authenticated Session for High-Entropy HttpOnly Cookies
model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relationships
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_sessions_user_id")
  @@index([expiresAt], name: "idx_sessions_expires_at")
  @@map("sessions")
}

/// Append-Only Audit Log for Administrative Actions and Security Governance
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(100)
  resource   String   @db.VarChar(100)
  resourceId String?  @map("resource_id") @db.VarChar(255)
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.Text
  metadata   Json?    @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relationships
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId], name: "idx_audit_logs_user_id")
  @@index([action], name: "idx_audit_logs_action")
  @@index([resource, resourceId], name: "idx_audit_logs_resource")
  @@index([createdAt(sort: Desc)], name: "idx_audit_logs_created_at")
  @@map("audit_logs")
}

/// Platform Configuration and Institutional Key-Value Store
model SystemSetting {
  key         String   @id @db.VarChar(100)
  value       Json     @db.JsonB
  description String?  @db.VarChar(255)
  isPublic    Boolean  @default(false) @map("is_public")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("system_settings")
}

// ------------------------------------------------------------------------------
// CONTENT MANAGEMENT & EDITORIAL WORKFLOW MODELS
// ------------------------------------------------------------------------------

enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum NewsCategory {
  OFFICIAL_ANNOUNCEMENT
  FUNDING_MILESTONE
  INFRASTRUCTURE
  ECOSYSTEM_PARTNERSHIP
}

/// Official Press Releases, Announcements, and Ecosystem Coverage
model NewsArticle {
  id                String            @id @default(uuid()) @db.Uuid
  slug              String            @unique @db.VarChar(100)
  category          NewsCategory      @default(OFFICIAL_ANNOUNCEMENT)
  publishDate       DateTime          @default(now()) @map("publish_date") @db.Timestamptz(6)
  sourceAttribution String            @map("source_attribution") @db.VarChar(200)
  externalPressLink String?           @map("external_press_link") @db.VarChar(255)
  thumbnailAssetId  String?           @map("thumbnail_asset_id") @db.Uuid
  currentVersion    Int               @default(1) @map("current_version")
  authorId          String?           @map("author_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  author            User?             @relation("AuthoredNews", fields: [authorId], references: [id], onDelete: SetNull)
  translations      NewsTranslation[]

  @@index([category], name: "idx_news_articles_category")
  @@index([publishDate], name: "idx_news_articles_publish_date")
  @@index([authorId], name: "idx_news_articles_author_id")
  @@map("news_articles")
}

/// Localized Content and Editorial Lifecycle for News Articles
model NewsTranslation {
  id          String        @id @default(uuid()) @db.Uuid
  articleId   String        @map("article_id") @db.Uuid
  locale      String        @db.VarChar(5)
  headline    String        @db.VarChar(255)
  summary     String        @db.VarChar(500)
  content     Json          @db.JsonB
  tags        Json          @default("[]") @db.JsonB
  keyFacts    Json?         @map("key_facts") @db.JsonB
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at") @db.Timestamptz(6)
  archivedAt  DateTime?     @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  article     NewsArticle   @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, locale], name: "uq_news_translations_locale")
  @@index([locale, status], name: "idx_news_translations_locale_status")
  @@map("news_translations")
}
