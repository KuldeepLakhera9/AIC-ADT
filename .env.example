# AIC-ADT Baramati Foundation — Environment Configuration Template
# Duplicate this file to .env for local development. Never commit real credentials.

# --- NODE ENVIRONMENT ---
NODE_ENV=development

# --- FRONTEND (Next.js) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_DEFAULT_LOCALE=en

# --- BACKEND (NestJS) ---
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# --- DATABASE (PostgreSQL 16+) ---
# Application runtime connection string (uses dedicated non-superuser role)
DATABASE_URL=postgresql://aic_app:aic_app_dev_password@127.0.0.1:5432/aic_adt_db?schema=public
SHADOW_DATABASE_URL=postgresql://aic_app:aic_app_dev_password@127.0.0.1:5432/aic_adt_shadow_db?schema=public

# Docker Compose container bootstrap admin (used solely for container creation)
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres_local_dev_password
POSTGRES_ADMIN_DB=postgres

# Dedicated application database and non-superuser role
APP_DB_NAME=aic_adt_db
APP_DB_USER=aic_app
APP_DB_PASSWORD=aic_app_dev_password
POSTGRES_PORT=5432

# --- STORAGE ---
STORAGE_PUBLIC_PATH=./storage/public
STORAGE_PRIVATE_PATH=./storage/private
