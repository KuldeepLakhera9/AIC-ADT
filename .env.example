# AIC-ADT Baramati Foundation — Environment Configuration Template
# Duplicate this file to .env for local development. Never commit real credentials.

# --- NODE ENVIRONMENT ---
NODE_ENV=development

# --- FRONTEND (Next.js) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_DEFAULT_LOCALE=en

# --- BACKEND (NestJS) ---
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# --- DATABASE (PostgreSQL - for Phase 3 Task 3 onwards) ---
DATABASE_URL=postgresql://aic_user:aic_password@localhost:5432/aic_adt_db?schema=public
POSTGRES_USER=aic_user
POSTGRES_PASSWORD=aic_password
POSTGRES_DB=aic_adt_db
POSTGRES_PORT=5432

# --- STORAGE ---
STORAGE_PUBLIC_PATH=./storage/public
STORAGE_PRIVATE_PATH=./storage/private
