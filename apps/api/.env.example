# ==============================================================================
# AIC-ADT Baramati Foundation — NestJS API Environment Configuration
# ==============================================================================

# Application Environment (development | staging | production | test)
NODE_ENV=development

# Server Port & API Routing Prefix
PORT=4000
API_PREFIX=api/v1

# Security & CORS (Comma-separated allowlisted frontend origins)
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database Connection String (Using dedicated non-superuser role 'aic_app')
# Format: postgresql://aic_app:PASSWORD@HOST:PORT/aic_adt_db?schema=public
DATABASE_URL=postgresql://aic_app:aic_app_dev_password@127.0.0.1:5432/aic_adt_db?schema=public
# Shadow Database for development migrations (avoids requiring superuser CREATEDB privilege)
SHADOW_DATABASE_URL=postgresql://aic_app:aic_app_dev_password@127.0.0.1:5432/aic_adt_shadow_db?schema=public

# Logging Configuration (debug | log | warn | error)
LOG_LEVEL=log

# Request Body Size Limit (e.g. 1mb, 2mb, 5mb)
BODY_LIMIT=1mb

# Rate Limiting (Throttler)
THROTTLE_TTL=60
THROTTLE_LIMIT=100
