# Dependencies
node_modules/
.pnpm-store/

# Next.js build output
.next/
out/

# NestJS build output
dist/
build/

# Testing & Coverage
coverage/
*.lcov
.nyc_output/

# Environment files (never commit real credentials)
.env
.env.*
!.env.example
!*.env.example
*.env
*.env.local

# Cryptographic keys, certificates & credentials
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks

# Database dumps, snapshots & backups
*.dump
*.sql.gz
*.backup

# Storage uploads & transient files
storage/private/*
!storage/private/.gitkeep
storage/public/uploads/*
!storage/public/uploads/.gitkeep

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# OS & Editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo

# Temporary / Scratch
tmp/
temp/
