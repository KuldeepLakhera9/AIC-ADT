# ==============================================================================
# AIC-ADT Baramati Foundation — NestJS API Environment Configuration
# ==============================================================================

# Application Environment (development | staging | production | test)
NODE_ENV=development

# Server Port & API Routing Prefix
PORT=4000
API_PREFIX=api/v1

# Security & CORS (Comma-separated allowlisted frontend origins)
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database Connection String
# Required in production. Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://aic_user:aic_password@localhost:5432/aic_adt_db?schema=public

# Logging Configuration (debug | log | warn | error)
LOG_LEVEL=log

# Request Body Size Limit (e.g. 1mb, 2mb, 5mb)
BODY_LIMIT=1mb

# Rate Limiting (Throttler)
THROTTLE_TTL=60
THROTTLE_LIMIT=100
